<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BursaProStock</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.highcharts.com/stock/highstock.js"></script>
    <script src="https://code.highcharts.com/stock/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/stock/modules/indicators.js"></script>
    <script src="https://code.highcharts.com/stock/indicators/indicators.js"></script>
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-moment@1.1.0/dist/chartjs-adapter-moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/chartjs-chart-financial"></script>

    
    
    
    
    <link rel="stylesheet" href="company.css">
    <script>
      // Provide data needed for the scripts to the window object
      window.chartData = `<%- JSON.stringify(chartData) %>`;
      window.chartData2 = `<%- JSON.stringify(chartData) %>`;
      window.chartData3 = `<%- JSON.stringify(chartData) %>`;
      window.chartData4 = `<%- JSON.stringify(chartData) %>`;
      window.companyDetail = `<%- JSON.stringify(companyDetail) %>`;
      window.lastRow = `<%- JSON.stringify(lastRow) %>`;
      window.newsData = `<%- JSON.stringify(newsData) %>`;
  </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="/static/main.js" defer></script>
</head>
<body>

    <!-- Navigation bar and company details code -->
    <header>
        <nav id="header" class="navbar navbar-expand-lg navbar-dark">
        
          <form action="/" method="get"><input class="logo" type="submit" value="MalaysiaStock-Pro"></form>
          
          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
              <li class="nav-item">
                <form action="/" method="get"> <button type="submit"  >Home</button></form>
              </li>
              <!-- <li class="nav-item">
                <a class="nav-link" href="#">News</a>
              </li> -->
              <li class="nav-item">
                <form action="/company-list" method="get"  > <button type="submit" >Company</button></form>
              </li>
            </ul>
            <form class="form-inline my-2 my-lg-0 search-bar" action="/veryFirst" method="post">
              <input class="form-control mr-sm-2" type="text" name="companyName"  placeholder="Search for other companies" aria-label="Search">
              <button class="btn btn-outline-light my-2 my-sm-0" type="submit">Search</button>
            </form>
          </div>
        </nav>
      </header>

    <div id="top-profile"> 

        <div class="intro">
            <div class="company-logo">
              <img src="<%= companyDetail.logo %>"  alt="Company Logo" />
            </div>
            <div class="name">
              <h1><%= companyDetail.companyName %></h1>
            </div>
            <div class="graph">
              <div class="chart-container" style="height: 120px;width: 300px; padding: 0;">
                <canvas id="stockChartTop" width="80" height="40"></canvas>
              </div> 
            </div>
        </div>
        
        <div class="head-details">
            
            <div class="open">
              <p>Latest Open: </p>
              <h4><%= lastRow[1] %> MYR</h4>

            </div>

            <div class="close2">
              <p>Latest Close: </p>
              <h4><%= lastRow[4] %> MYR</h4>
          </div>
          
            <div class="high">
              <p>Today's High: </p>
              <h4><%= lastRow[2] %> MYR</h4>

            </div>
            <div class="other">
              <p>Website: </p>
              <a href="<%= companyDetail.website.replace(/"$/, '') %>"><%= companyDetail.website.replace(/"$/, '') %></a></p>
            </div>
        </div>
    </div>
    
    <div id="hidden-logo">
       <img src="stock.jpg" alt="EASILY-INVEST Logo" />
    </div>


    <div id="all-content">

        <!-- Sidebar and main content -->

        <div class="side-navbar">
            <div class="out-li">
          
            </div>
            
            <ul>
              <li class="clicked"><a  href="#top-profile">Company Overview</a></li>
  
              <li><a href="#company-profile">1. Company Profile</a></li>
  
              <li><a href="#candlestick-chart">2. CandleStick Chart</a></li>
             

              <li><a href="#line-chart">3. Line Chart</a></li>
           
              <li><a href="#news">4. News Feed</a></li>
              <!-- <li><a href="#risk-analysis">5. Risk Analysis</a></li> -->
              <li><a href="#top-profile">Move to Top</a></li>
  
            </ul>
            <div class="out-li">
             
            </div>
        </div>
        
        <div class="main">

            <!-- Risk Analysis, Candlestick Chart, Company Profile, Line Chart, News Feed sections -->

        
            <section id="company-profile">
              <!-- Your existing HTML and EJS content -->
              <h1 class="section-heading">Company-Profile</h1>

          <div id="cp-second">
            <div class="name-address">
                <h3><%= companyDetail.companyName %></h3>
                <p>Symbol: <%= companyDetail.symbol %></p>
                <p >Address: <span class="real-add"><%= companyDetail.address %></span></p>
                <p>Phone: <%= companyDetail.phoneNumber %></p>
                <p>Website: <a href="<%= companyDetail.website.replace(/"$/, '') %>"><%= companyDetail.website.replace(/"$/, '') %></a></p>
                <p>Sector: <%= companyDetail.sector %></p>
                <p>Industry: <%= companyDetail.industry %></p>
                <p>Full Time Employees: <%= companyDetail.fullTimeEmployees %></p>
            </div>
          <div class="exec">
                <h3>Key Executives</h3>
                <p>CEO: <%= companyDetail.ceoName %></p>
                <p>CFO: <%= companyDetail.cfoName %></p>

            </div>
            <div class="description">
              <h3>Description</h3>
              <div class="content-short"><%= companyDetail.companyDescription %></div>
              <div class="content-full"><%= companyDetail.companyDescription %></div>
              <button class="view-more">View More</button>
              
            </div>
            <div class="company-logo2">
              <img class="description-img"  src="<%= companyDetail.logo %>"  alt="Company Logo" />
              <div class="graph">
                <div class="chart-container" style="height: 120px;width: 200px; padding: 0; 
                border-radius: 5px; margin:15px; padding: 5%; background-color: white;">
                  <canvas id="stockChart4" width="80" height="40"></canvas>
                </div> 
              </div>
            </div>

          </div>
          </section>


          <section id="candlestick-chart">
                <div id="candlestick" class="content-div">
                    <h1 class="section-heading">Candlestick Chart</h1>
                    <div id="stockChartContainer"></div>
                    <!-- <canvas id="stockChartContainer"></canvas> -->
                </div>
          </section>

            

            <section id="line-chart">
                <div id="linechart" class="content-div">
                    <!-- Your existing HTML and EJS content -->
                    <h1 class="section-heading">Line Chart</h1>
                    <canvas id="mainLineChart"></canvas>
                </div>
            </section>

            <section id="news">
              <div class="news-div">
                  <!-- Your existing HTML and EJS content -->
                  <h1 class="section-heading">Latest News</h1>
                  <% if (newsData.length === 0) { %>
                    <!-- Display a message when there are no news items -->
                    <div style="text-align: center; color: red; margin:20px auto; opacity: 0.6;">
                      <img src="https://t4.ftcdn.net/jpg/02/68/10/27/240_F_268102758_Xra349ZbgXBgD5Zlyhav6GoOJh9RQE5n.jpg" alt="">
                      <h3>Oh! No News available for this company today</h3>
                      <h3>kindly, check back tomrrow :)</h3>
                    </div>
                  <% } else { %>
                    <!-- style="background-color: #999cde; padding: 10px; border-radius: 10px;" -->
                    <% newsData.forEach((newsItem) => { %>
                      <div class="eachNews">
                        <h2><%= newsItem.title %></h2>
                        <a href="<%= newsItem.link %>"> <img src="<%= newsItem.imageSrc%>" alt="News Image"></a>
                        <p><%= newsItem.summary %></p>
                        <a href="<%= newsItem.link %>" class="newsButton">Read More</a>
                        <hr>
                      </div>
                    <% }) %>
                  <% } %>
              </div>
          </section>
          
            <!-- <section id="risk-analysis">
              
              <h1 class="section-heading">Risk Analysis</h1>
          </section> -->
        </div>
    </div>
    
    
</body>
</html>
